# Consumer (src/index.js)
# Loaded by `import "dotenv/config"` at the top of src/index.js.

SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/<queue-name>
SQS_CLIENT_ACCESS_KEY_ID=
SQS_CLIENT_SECRET_ACCESS_KEY=

# Used by the ECS client in the consumer, and by the S3 client in the container.
S3_CLIENT_ACCESS_KEY_ID=
S3_CLIENT_SECRET_ACCESS_KEY=

# ECS RunTask settings previously hardcoded in src/index.js.
# ECS_SECURITY_GROUPS and ECS_SUBNETS are comma-separated.
ECS_TASK_DEFINITION=<task-definition-name>
ECS_CLUSTER=<cluster-arn>
ECS_LAUNCH_TYPE=FARGATE
ECS_ASSIGN_PUBLIC_IP=ENABLED
ECS_SECURITY_GROUPS=<security-group-ids>
ECS_SUBNETS=<subnet-ids>
ECS_CONTAINER_NAME=<container-name>

# Container only. Set these on the ECS task definition, not on the consumer.
# BUCKET_NAME, KEY, and POST_ID are injected per video by RunTask.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
S3_BUCKET_NAME=<output-bucket-name>
